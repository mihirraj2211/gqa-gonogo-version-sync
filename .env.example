# Copy to .env for local runs: set -a && source .env && set +a
# .env is gitignored. Never commit real tokens.

# --- Confluence ---
# The same Atlassian API token works for Jira and Confluence.
CONFLUENCE_DOMAIN=wbdstreaming.atlassian.net
# One page per train. Leave this blank and each run finds the current train's
# page by title in the space below, which is how a new train needs no change.
# Set it to pin one page, e.g. a "Copy of ..." page to rehearse against.
CONFLUENCE_PAGE_ID=
CONFLUENCE_SPACE_KEY=GQA
ATLASSIAN_USER_EMAIL=you@wbd.com
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# --- Build source (Fuse build API) ---
# Base URL is https://sprintedge.gqa.discomax.com/sprintedge/fuse and the sync
# reads one card per device from /api/latest-versions, once per product.
FUSE_BUILDS_API_URL=https://sprintedge.gqa.discomax.com/sprintedge/fuse/api/latest-versions
# A SprintEdge gate token, sent as ?token=. A JFrog api_token is NOT enough:
# it only opens get_latest_build_url, not the JSON version routes.
FUSE_API_TOKEN=

# --- Build source (JFrog Artifactory, when BUILD_PROVIDER=jfrog) ---
# JFROG_URL=https://discovery.jfrog.io
# JFROG_TOKEN=

# --- Optional overrides ---
# BUILD_PROVIDER=fuse_api   # fuse_api | grafana | jfrog
# Pin the train instead of reading it from the page title.
# RELEASE_TRAIN=7.12.0
# ENFORCE_TRAIN=false       # accept builds from any train (not recommended)
