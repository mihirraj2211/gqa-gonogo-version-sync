# Copy to .env for local runs: set -a && source .env && set +a
# .env is gitignored. Never commit real tokens.

# --- Confluence ---
CONFLUENCE_DOMAIN=wbdstreaming.atlassian.net
CONFLUENCE_PAGE_ID=4137255661
ATLASSIAN_USER_EMAIL=you@wbd.com
# https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=

# --- Build source (Fuse build API) ---
# The endpoint from the "Build Fetch API - curl Reference" page.
FUSE_BUILDS_API_URL=
FUSE_API_TOKEN=

# --- Optional overrides ---
# BUILD_PROVIDER=fuse_api   # fuse_api | grafana | jfrog
# RELEASE_TRAIN=7.12.0
