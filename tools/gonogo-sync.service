# Adjust WorkingDirectory/ExecStart if the repo lives somewhere else.
[Unit]
Description=Sync Go/No-Go build versions into the GQA sign-off page
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/WBD/gqa-gonogo-version-sync
ExecStart=%h/WBD/gqa-gonogo-version-sync/tools/run-sync.sh
