[Unit]
Description=Run the Go/No-Go version sync every 15 minutes

[Timer]
# Fixed minutes rather than an interval from the last finish, which drifts by
# the length of each run.
OnCalendar=*:00/15
AccuracySec=30s
# Catch up after a suspend or a reboot rather than waiting a full interval.
Persistent=true

[Install]
WantedBy=timers.target
